# Copy to .env for local use (never commit .env). On Vercel, add these in
# Project Settings -> Environment Variables.
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=research_portal
# Most cloud MySQL providers require SSL. Use "false" for local MySQL.
DB_SSL=true
